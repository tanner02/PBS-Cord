set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(TESTING OFF CACHE BOOL "" FORCE)
set(PERSISTENT_KEYS OFF CACHE BOOL "" FORCE)
set(REQUIRE_BORINGSSL OFF CACHE BOOL "" FORCE)
set(DISABLE_GREASE ON CACHE BOOL "" FORCE)
set(MLS_CXX_NAMESPACE "mlspp" CACHE STRING "" FORCE)
set(CMAKE_FIND_PACKAGE_NO_PACKAGE_REGISTRY ON)
set(CMAKE_EXPORT_NO_PACKAGE_REGISTRY ON)
find_package(OpenSSL 3 REQUIRED)
find_package(nlohmann_json 3.11 CONFIG REQUIRED)
if(PBS_PS5)
    find_path(SODIUM_INCLUDE_DIR sodium.h REQUIRED)
    find_library(SODIUM_LIBRARY NAMES sodium REQUIRED)
    find_path(OPUS_INCLUDE_DIR opus/opus.h REQUIRED)
    find_library(OPUS_LIBRARY NAMES opus REQUIRED)
    add_library(pbs_sodium STATIC IMPORTED)
    set_target_properties(pbs_sodium PROPERTIES IMPORTED_LOCATION "${SODIUM_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${SODIUM_INCLUDE_DIR}")
    add_library(pbs_opus STATIC IMPORTED)
    set_target_properties(pbs_opus PROPERTIES IMPORTED_LOCATION "${OPUS_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${OPUS_INCLUDE_DIR};${OPUS_INCLUDE_DIR}/opus")
    set(SODIUM_TARGET pbs_sodium)
    set(OPUS_TARGET pbs_opus)
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(SODIUM REQUIRED IMPORTED_TARGET libsodium)
    pkg_check_modules(OPUS REQUIRED IMPORTED_TARGET opus)
    set(SODIUM_TARGET PkgConfig::SODIUM)
    set(OPUS_TARGET PkgConfig::OPUS)
endif()
add_subdirectory(vendor/mlspp EXCLUDE_FROM_ALL)
add_library(MLSPP::mlspp ALIAS mlspp)
add_library(MLSPP::hpke ALIAS hpke)
# libdave calls find_dependency; reuse the targets already defined above.
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/mlspp-shim")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/mlspp-shim/MLSPPConfig.cmake" "set(MLSPP_FOUND TRUE)\n")
set(MLSPP_DIR "${CMAKE_CURRENT_BINARY_DIR}/mlspp-shim" CACHE PATH "" FORCE)
add_subdirectory(vendor/libdave/cpp EXCLUDE_FROM_ALL)
